# ==============================================================================
# ServiceLog Intelligence Hub - Template Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    Windows PowerShell: Copy-Item .env.example .env
#    Linux / macOS:      cp .env.example .env
# 2. Adjust any parameters below to customize your branding, thresholds, or models.
# 3. Never commit your actual '.env' file containing private settings to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Branding & Identity (Dynamic UI)
# ------------------------------------------------------------------------------
# All UI titles, headers, brand names, and badges are dynamically read from here.
# Zero hardcoding is present in the codebase.
APP_NAME=ServiceLog Intelligence Hub
APP_TITLE=ServiceLog Intelligence Hub | Enterprise Observability & Root Cause Analysis
APP_TAGLINE=Beyond Observability
APP_SUBTITLE=Autonomous Log Intelligence, SRE Diagnostic Triage & Multi-Service Monitoring
APP_ORG_NAME=LogTrax Enterprise
APP_NAV_BADGE=Observability Hub

# ------------------------------------------------------------------------------
# 2. Operational SLA Threshold
# ------------------------------------------------------------------------------
# Target success rate percentage for services before alerting or marking degraded.
SLA_TARGET_PERCENT=95.0

# ------------------------------------------------------------------------------
# 3. Network Host & Server Port
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=True

# ------------------------------------------------------------------------------
# 4. Storage & Ingestion Directories
# ------------------------------------------------------------------------------
# Path where raw .log files are read or uploaded
LOGS_DIR=service_logs

# Path where the embedded SQLite database (logs.db) and FTS5 indexes are stored
DATA_DIR=backend/data

# ------------------------------------------------------------------------------
# 5. Local Offline In-Memory SLM (Small Language Model) Configuration
# ------------------------------------------------------------------------------
# Provider: 'qwen' runs completely offline in RAM via PyTorch & Transformers.
PROVIDER=qwen

# Select your model size based on available system RAM:
# • 0.5B (Fastest, ~1.0 GB RAM): Qwen/Qwen2.5-0.5B-Instruct
# • 1.5B (Balanced, ~3.0 GB RAM): Qwen/Qwen2.5-1.5B-Instruct
# • 3.0B (Deep RCA, ~6.0 GB RAM): Qwen/Qwen2.5-3B-Instruct
# Default active model: Qwen 2.5 3B (High-Precision Deep RCA)
LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct

# Local directory where model weights can be stored locally, or leave as default:
MODEL_PATH=models/Qwen2.5-3B-Instruct

# Maximum new tokens to generate per response:
MAX_NEW_TOKENS=220
